local function fromHex(hex)
    local bytes = {}
    for index = 1, #hex, 2 do
        local value = tonumber(hex:sub(index, index + 1), 16)
        bytes[#bytes + 1] = string.char(value)
    end
    return table.concat(bytes)
end

local function checksum(hex, key)
    local value = tonumber(key) or 42
    for index = 1, #hex do
        value = bit32.bxor(value, string.byte(hex, index) or 0)
        value = (value * 31 + index * 997) % 4294967295
    end
    return string.format("%08x", value)
end

local function makeKeyStream(key, count)
    local stream = {}
    local keyText = tostring(key)
    local state = 0

    for index = 1, count do
        local firstIndex = (index % #keyText) + 1
        local firstByte = string.byte(keyText, firstIndex) or 0
        state = (state * 31 + firstByte + index * 997) % 256

        local secondIndex = ((index * firstByte + state) % #keyText) + 1
        local secondByte = string.byte(keyText, secondIndex) or 0
        local mixed = bit32.bxor(secondByte, state, index % 256)
        stream[index] = (mixed + index * 7) % 256
    end

    return stream
end

