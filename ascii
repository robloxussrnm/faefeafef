        state = (state * 31 + firstByte + index * 997) % 256

        local secondIndex = ((index * firstByte + state) % #keyText) + 1
        local secondByte = string.byte(keyText, secondIndex) or 0
        local mixed = bit32.bxor(secondByte, state, index % 256)
        stream[index] = (mixed + index * 7) % 256
    end

    return stream
end

